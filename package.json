{
  "name": "@lancemoe/react-daisyui",
  "version": "7.0.2",
  "description": "react-daisyui - DaisyUI components built with React 🌼",
  "author": "daisyui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanceMoe/react-daisyui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-daisyui.esm.js",
      "require": "./dist/react-daisyui.cjs",
      "default": "./dist/react-daisyui.esm.js"
    }
  },
  "main": "./dist/react-daisyui.cjs",
  "module": "./dist/react-daisyui.esm.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "storybook dev -p 6006",
    "dev": "storybook dev -p 6006",
    "dist": "vite build && node node_modules/typescript-7/bin/tsc -p tsconfig.build.json --emitDeclarationOnly",
    "docs": "storybook build -o ./docs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "format": "prettier --write ./src",
    "prepublishOnly": "pnpm run dist",
    "postpublish": "git push --no-verify && git push --tags",
    "version": "pnpm run docs && git add -A docs",
    "generate": "plop"
  },
  "peerDependencies": {
    "daisyui": "^5.7.28",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.27",
    "prettier": "^3.9.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod-validation-error": "^5.0.0"
  }
}
