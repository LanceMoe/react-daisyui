{
  "name": "react-daisyui",
  "version": "5.0.5",
  "description": "react-daisyui - DaisyUI components built with React 🌼",
  "author": "daisyui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daisyui/react-daisyui.git"
  },
  "type": "module",
  "exports": {
    "import": "./dist/react-daisyui.modern.js",
    "require": "./dist/react-daisyui.cjs",
    "default": "./dist/react-daisyui.modern.js",
    "types": "./dist/index.d.ts"
  },
  "main": "./dist/react-daisyui.cjs",
  "module": "./dist/react-daisyui.esm.js",
  "unpkg": "./dist/react-daisyui.umd.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "storybook dev -p 6006",
    "dist": "microbundle --jsx React.createElement --jsxFragment React.Fragment --jsxImportSource react --globals react/jsx-runtime=jsx --format modern,cjs,esm --css inline --compress false",
    "docs": "storybook build -o ./docs -s ./public",
    "test": "jest",
    "format": "prettier --write ./src",
    "prepublishOnly": "npm run dist",
    "postpublish": "git push --no-verify && git push --tags",
    "version": "npm run docs && git add -A docs",
    "generate": "plop"
  },
  "peerDependencies": {
    "daisyui": "^5.7.27",
    "react": ">=16",
    "react-dom": ">=16",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.4.1",
    "clsx": "^1.2.1",
    "eslint-plugin-mdx": "^1.17.1",
    "jest": "^27.5.1",
    "microbundle": "^0.14.2",
    "npm": "^9.9.4",
    "plop": "^3.1.2",
    "postcss": "^8.5.26",
    "prettier": "^2.8.8",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^1.14.0",
    "ts-jest": "^27.1.5",
    "typescript": "^4.9.5",
    "vite": "^8.0.0"
  }
}
